@model WebApplicationShop.Models.ProductsIndexViewModel

<h1>Каталог товаров</h1>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label">Категория</label>
        <select name="categoryId" class="form-select">
            <option value="">Все категории</option>
            @foreach (var cat in Model.Categories)
            {
                <option value="@cat.Id" selected="@(Model.SelectedCategoryId == cat.Id)">
                    @cat.Name
                </option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Цена от</label>
        <input type="number" name="minPrice" value="@Model.MinPrice" min="0" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Цена до</label>
        <input type="number" name="maxPrice" value="@Model.MaxPrice" min="0" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Сортировка</label>
        <select name="sort" class="form-select">
            <option value="name" selected="@(Model.Sort == "name")">По названию (А-Я)</option>
            <option value="name_desc" selected="@(Model.Sort == "name_desc")">По названию (Я-А)</option>
            <option value="price" selected="@(Model.Sort == "price")">Сначала дешёвые</option>
            <option value="price_desc" selected="@(Model.Sort == "price_desc")">Сначала дорогие</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Показать</button>
        <a asp-action="Index" class="btn btn-light">Сброс</a>
    </div>
</form>

<p class="text-muted">Найдено товаров: @Model.Products.Count</p>

@if (User.IsInRole("Admin") || User.IsInRole("Manager"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">Добавить товар</a>
}

<div class="row">
    @foreach (var product in Model.Products)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text">@product.Description</p>
                    <p class="card-text"><strong>@product.Price ₽</strong></p>
                    <div>
                        @foreach (var cat in product.Categories)
                        {
                            <span class="badge bg-dark">@cat.Name</span>
                        }
                    </div>
                    <div class="mt-2">
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-secondary">Изменить</a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Удалить</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>